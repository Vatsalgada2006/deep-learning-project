# Frontend environment variables for Vite
# Copy this file to .env.local for local development

# HTTP API base URL (no trailing slash)
# Dev: http://localhost:8001
# Prod: https://your-backend.onrender.com
VITE_API_URL=http://localhost:8001

# WebSocket URL (ws:// for local, wss:// for production)
# Dev: ws://localhost:8001/ws/alerts
# Prod: wss://your-backend.onrender.com/ws/alerts
VITE_WS_URL=ws://localhost:8001/ws/alerts