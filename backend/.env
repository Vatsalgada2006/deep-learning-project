# Road Accident Detection System - Environment Variables
# Copy this file to .env and fill in the values

# Model Configuration
MODEL_PATH=model.onnx
SEQ_LENGTH=10
IMG_SIZE=128

# Video Configuration
VIDEO_PATH=./sample_video.mp4  # Path to sample video for simulation

# Server Configuration
PORT=8001
HOST=0.0.0.0

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
# For MongoDB Atlas, use format:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/accident_detection?retryWrites=true&w=majority

# Discord Webhook (for alerts)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# CORS Origins (adjust for production)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com